# Copy to .env and fill in. Never commit .env.
# Keep the simulator gateway until you deliberately opt in to the real stove.
STOVE_PILOT_GATEWAY=simulator
# Development only: restart the API and the UI when a source file is saved.
# Leave this unset for the scheduled task (each API restart reconnects to the stove).
# STOVE_PILOT_DEV=false
# STOVE_PILOT_SIMULATOR_SEED=./discovery/seed.json

STOVE_PILOT_NAVEL_BASE_URL=http://192.168.68.54
STOVE_PILOT_NAVEL_DEVICE_ID=<module MAC address>
STOVE_PILOT_NAVEL_SECURITY=<AP password from module label>
STOVE_PILOT_NAVEL_TIMEOUT_S=10.0
STOVE_PILOT_NAVEL_MIN_INTERVAL_S=0.2
# Maximum items per module request (1..16). Lowered at runtime when the module returns blank replies, then raised again after 20 successful reads.
STOVE_PILOT_NAVEL_CHUNK_SIZE=8

STOVE_PILOT_PROFILE=superior_maira
STOVE_PILOT_FEATURES=["chrono"]
STOVE_PILOT_DB_PATH=./data/stove-pilot.sqlite
STOVE_PILOT_TIMEZONE=Europe/Paris
STOVE_PILOT_POLL_INTERVAL_S=30
# Minimum seconds between two reads of the slow status registers (ENERGY SAVING offsets, live clock).
STOVE_PILOT_SLOW_READ_INTERVAL_S=300
STOVE_PILOT_SAMPLE_INTERVAL_S=60
# Days of history to keep; 0 = keep forever.
STOVE_PILOT_HISTORY_RETENTION_DAYS=0
# Short-cycle warning (SHORT_CYCLE): raised when a new start is strictly sooner than this many minutes after the previous one (default 90, from 1 to 1440). Exactly this interval is compliant. Advice only: it never starts or stops the stove.
# STOVE_PILOT_SHORT_CYCLE_MIN_INTERVAL_MIN=90
STOVE_PILOT_MIN_RESTART_INTERVAL_MIN=15
# Safety restart. The four *_DEFAULT* variables only seed the values until the user saves the Reglages card.
# Enabled, threshold, max attempts and the retry interval then live in the safety SQLite schema.
# A retry default below STOVE_PILOT_MIN_RESTART_INTERVAL_MIN is raised to that minimum with one startup warning.
# Confirm polls, rearm hysteresis and the chrono stop window stay container settings.
STOVE_PILOT_SAFETY_ENABLED_DEFAULT=false
STOVE_PILOT_SAFETY_THRESHOLD_DEFAULT_C=10
STOVE_PILOT_SAFETY_MAX_ATTEMPTS_DEFAULT=3
STOVE_PILOT_SAFETY_RETRY_INTERVAL_DEFAULT_MIN=15
# Consecutive fresh polls at or below the threshold before a start (1..10).
STOVE_PILOT_SAFETY_CONFIRM_POLLS=2
# Degrees above the threshold that rearm a waiting or failed episode (0.5..5).
STOVE_PILOT_SAFETY_REARM_HYSTERESIS_C=1.0
# Minutes after a chrono stop minute still counted as that chrono stop (1..15).
STOVE_PILOT_SAFETY_CHRONO_STOP_WINDOW_MIN=5
STOVE_PILOT_DEFERRED_START_EXPIRY_MIN=45
STOVE_PILOT_DEFERRED_STOP_EXPIRY_MIN=30
# Automatic clock sync runs only when the absolute drift is strictly above this many seconds (30..3600; default 300 = 5 min).
STOVE_PILOT_CLOCK_DRIFT_TOLERANCE_S=300
# Initial value of the auto-sync toggle; the Reglages page toggle is stored in the database and then takes precedence.
STOVE_PILOT_CLOCK_AUTO_SYNC=true
STOVE_PILOT_CLOCK_SYNC_MIN_INTERVAL_H=6
STOVE_PILOT_LIVE_READ_MIN_INTERVAL_S=5
# Frost-protection setpoint in degrees Celsius applied by the vacation mode (7..12).
STOVE_PILOT_VACATION_SETPOINT_C=7

STOVE_PILOT_API_HOST=127.0.0.1
STOVE_PILOT_API_PORT=8710
# Optional. When empty, the API skips the key check (keep the API on localhost or a private Docker network).
STOVE_PILOT_API_KEY=

STOVE_PILOT_UI_HOST=0.0.0.0
STOVE_PILOT_UI_PORT=8711
STOVE_PILOT_UI_API_BASE_URL=http://127.0.0.1:8710
# Optional. When empty, a random CSRF secret is generated at each startup.
STOVE_PILOT_UI_SECRET_KEY=
# Who may embed /widget in an iframe (CSP frame-ancestors), for example 'self' http://homeassistant.local:8123
STOVE_PILOT_UI_FRAME_ANCESTORS="'self'"
# Default display refresh interval in seconds: 0 (manual), 10, 30, 60 or 300. Each browser can override it.
STOVE_PILOT_UI_REFRESH_DEFAULT_S=30
# Events per page on the History page (5..100).
STOVE_PILOT_UI_HISTORY_EVENTS_PAGE_SIZE=25
